DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@postgres:5432/property_management
MONGODB_URL=mongodb://mongo:yourpassword@mongodb:27017
REDIS_URL=redis://redis:6379
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
CONFIDENCE_THRESHOLD=0.65
APP_NAME=AI Property Management
DEBUG=false

# Email for one-time codes (sign-up verification and password reset).
# Gmail: turn on 2-Step Verification, create an App password, and put it here WITHOUT spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=
SMTP_FROM="PropAI <your.address@gmail.com>"

# Development only: with no SMTP configured, print one-time codes in the backend log instead of failing. Never enable in production.
# EMAIL_DEV_LOG_CODES=true
