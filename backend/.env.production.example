# PRODUCTION settings for PropAI. Copy to backend/.env (Docker on your own server) or enter these in your host's dashboard
# (Render / Railway / ...). NEVER commit the real values, and never paste them in chat or email.
#
# Generate a secret:   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Databases: use the addresses your host gives you, with strong passwords (not postgres123 / mongo123) ───────────────
DATABASE_URL=postgresql+asyncpg://propai:CHANGE_ME@postgres:5432/property_management
MONGODB_URL=mongodb+srv://USER:CHANGE_ME@your-cluster.mongodb.net
REDIS_URL=redis://redis:6379

# ── Login security ────────────────────────────────────────────────────────────────────────────────────────────────────
# The app REFUSES TO START if this is the placeholder or shorter than 32 characters.
SECRET_KEY=PASTE_A_LONG_RANDOM_VALUE_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Must be false / off on a live site ────────────────────────────────────────────────────────────────────────────────
DEBUG=false                      # true prints every SQL statement (including password hashes) into the logs
EMAIL_DEV_LOG_CODES=false        # true writes one-time codes into the logs

# ── Who may call the API: the website's address, exactly as typed in the browser (comma separated, no trailing slash) ──
FRONTEND_URL=https://your-website.example.com
# Optional, for preview deployments only (a "*" inside a normal origin does not work):
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Files ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Must be on a persistent disk / volume, or uploaded bills and photos disappear on every redeploy.
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
CONFIDENCE_THRESHOLD=0.65
APP_NAME=AI Property Management

# ── Email for sign-up and password-reset codes (required: without it nobody can register or reset a password) ─────────
# Gmail: 2-Step Verification on -> create an App password -> paste it WITHOUT spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=
SMTP_FROM="PropAI <your.address@gmail.com>"
