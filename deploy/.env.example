# Copy to deploy/.env on the SERVER and fill in every value. Never commit deploy/.env or paste it in chat.
# Passwords: use only letters and digits (they go inside connection addresses). Make each one with:  openssl rand -hex 24

# The address people type in the browser, WITHOUT https:// . For a free name see deploy/README.md (DuckDNS).
DOMAIN=yourname.duckdns.org

# Where the WEBSITE lives (exactly as typed in the browser, no trailing slash). Only this address may call the API.
#   Website on Vercel (default setup):
WEBSITE_URL=https://your-project.vercel.app
CADDYFILE=./Caddyfile.api-only
#   ...or to serve the website from this same server instead, replace the three lines above with:
#   WEBSITE_URL=https://yourname.duckdns.org
#   CADDYFILE=./Caddyfile
#   COMPOSE_PROFILES=website

POSTGRES_PASSWORD=
MONGO_PASSWORD=

# Login-signing secret. The app refuses to start if it is short. Make it with:  openssl rand -hex 48
SECRET_KEY=

# Email for sign-up / password-reset codes (Gmail: turn on 2-Step Verification, create an App password, paste it WITHOUT spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=
SMTP_FROM="PropAI <your.address@gmail.com>"
