# Caddy gets and renews the HTTPS certificate by itself (Let's Encrypt) for whatever DOMAIN is set to.
{$DOMAIN} {
	encode gzip

	# /api/... -> the FastAPI backend (the /api prefix is removed before it arrives)
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# everything else -> the website
	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
